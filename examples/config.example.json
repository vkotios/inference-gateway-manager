              16384,
              32768,
              65536,
              131072
            ],
            "adjustable": true
          }
        }
      },
      "profiles": {
        "gguf": {
          "argv": [
            "/opt/llama/llama-server",
            "-m",
            "{path}",
            "--host",
            "127.0.0.1",

            "--port",
            "8080",
            "--slots",
            "--ctx-size",
            "{context}"
          ],
          "base_url": "http://127.0.0.1:8080",
          "context": 32768,
          "context_limits": {
            "min": 4096,
            "max": 131072,
            "presets": [
              4096,

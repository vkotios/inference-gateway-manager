            "--port",
            "8082",
            "--ctx",
            "{context}",
            "--sessions",
            "1",
            "--no-vision"
          ],
          "cwd": "/opt/kyojin",
          "base_url": "http://127.0.0.1:8082",
          "context": 32768,
          "context_limits": {
            "min": 4096,
            "max": 131072,
            "presets": [
              4096,
              8192,
              16384,
              32768,
              65536,
              131072
            ],
            "adjustable": true
          },
          "probe": "slots",
          "env": {
            "PYTHONPATH": "/opt/kyojin",
            "EXL3_ROOT": "/opt/kyojin"
          }
        }
      }

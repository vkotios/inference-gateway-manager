{
  "host": "127.0.0.1",
  "port": 9000,
  "recovery": {
    "restart_gateway": false,
    "reboot_host": false
  },
  "allowed_hosts": [
    "127.0.0.1",
    "localhost"
  ],
  "allowed_networks": [
    "127.0.0.0/8"
  ],
  "native_matchers": [
    {
      "exe": "llama-server"
    },
    {
      "argv_contains": "serve.server"
    },
    {
      "argv_contains": "tools/qwen/serve.py"
    },
    {
      "argv_contains": "tools/glm/serve.py"
    },
    {
      "argv_contains": "tools/mimo/serve.py"
    },
    {
      "exe": "ds4-server"
    },
    {
      "exe": "gufo"
    },
    {
      "exe": ".gufo-wrapped"
    },
    {
      "exe": "gufo-server"
    }
  ],
  "engines": {
    "llama": {
      "models": {
        "example-llama": {
          "argv": [
            "/opt/llama/llama-server",
            "-m",
            "/opt/models/model.gguf",
            "--host",
            "127.0.0.1",
            "--port",
            "8080",
            "--slots",
            "--ctx-size",
            "{context}"
          ],
          "base_url": "http://127.0.0.1:8080",
          "context": 32768,
          "context_limits": {
            "min": 4096,
            "max": 131072,
            "presets": [
              4096,
              8192,
              16384,
              32768,
              65536,
              131072
            ],
            "adjustable": true
          }
        }
      },
      "profiles": {
        "gguf": {
          "argv": [
            "/opt/llama/llama-server",
            "-m",
            "{path}",
            "--host",
            "127.0.0.1",
            "--port",
            "8080",
            "--slots",
            "--ctx-size",
            "{context}",
            "--alias",
            "{model}"
          ],
          "base_url": "http://127.0.0.1:8080",
          "context": 32768,
          "format": "gguf",
          "context_limits": {
            "min": 4096,
            "max": 131072,
            "presets": [
              4096,
              8192,
              16384,
              32768,
              65536,
              131072
            ],
            "adjustable": true
          }
        },
        "hybrid-gguf": {
          "argv": [
            "/opt/llama/llama-server",
            "-m",
            "{path}",
            "--host",
            "127.0.0.1",
            "--port",
            "8080",
            "--slots",
            "--ctx-size",
            "{context}",
            "--alias",
            "{model}"
          ],
          "base_url": "http://127.0.0.1:8080",
          "context": 32768,
          "format": "gguf",
          "context_limits": {
            "min": 4096,
            "max": 131072,
            "presets": [
              4096,
              8192,
              16384,
              32768,
              65536,
              131072
            ],
            "adjustable": true
          },
          "reasoning_modes": [
            "auto",
            "on",
            "off"
          ],
          "reasoning_change": "request",
          "reasoning_defaults": {
            "on": {
              "/v1/chat/completions": {
                "chat_template_kwargs": {
                  "enable_thinking": true
                }
              },
              "/v1/responses": {
                "reasoning": {
                  "effort": "medium"
                }
              }
            },
            "off": {
              "/v1/chat/completions": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              },
              "/v1/responses": {
                "reasoning": {
                  "effort": "none"
                }
              }
            }
          },
          "label": "Hybrid reasoning GGUF (administrator reviewed Qwen3.8 template)",
          "supported_architectures": [
            "qwen35"
          ]
        }
      }
    },
    "strata": {
      "models": {
        "qwen3.8-flash-next": {
          "argv": [
            "/opt/strata/.venv/bin/python",
            "-m",
            "serve.server",
            "--engine",
            "strata",
            "--config",
            "{config_path}",
            "--host",
            "127.0.0.1",
            "--port",
            "8081"
          ],
          "cwd": "/opt/strata",
          "base_url": "http://127.0.0.1:8081",
          "context": 262144,
          "upstream_model": "qwen3.8-flash-next-unsloth-ud-q4_k_xl",
          "config_template": {
            "exe": "/opt/strata/build/strata",
            "cwd": "/opt/strata",
            "args": [
              "--pack",
              "/opt/models/strata-pack",
              "--native",
              "/opt/models/qwen3.8-flash-next-00001-of-00004.gguf",
              "--max-context",
              "{context}"
            ],
            "tokenizer": "/opt/models/strata-pack/tokenizer",
            "model_name": "qwen3.8-flash-next-unsloth-ud-q4_k_xl"
          },
          "context_limits": {
            "min": 4096,
            "max": 262144,
            "presets": [
              4096,
              8192,
              16384,
              32768,
              65536,
              131072,
              262144
            ],
            "adjustable": true
          }
        }
      },
      "profiles": {
        "native-gguf": {
          "format": "native",
          "argv": [
            "/opt/strata/.venv/bin/python",
            "-m",
            "serve.server",
            "--engine",
            "strata",
            "--config",
            "{config_path}",
            "--host",
            "127.0.0.1",
            "--port",
            "8081"
          ],
          "cwd": "/opt/strata",
          "base_url": "http://127.0.0.1:8081",
          "context": 32768,
          "context_limits": {
            "min": 4096,
            "max": 131072,
            "presets": [
              4096,
              8192,
              16384,
              32768,
              65536,
              131072
            ],
            "adjustable": true
          },
          "artifacts": {
            "tokenizer": {
              "kind": "directory",
              "required_files": [
                "tokenizer.json"
              ]
            }
          },
          "config_template": {
            "exe": "/opt/strata/build/strata",
            "cwd": "/opt/strata",
            "args": [
              "--max-context",
              "{context}",
              "--native",
              "{path}"
            ],
            "tokenizer": "{artifact.tokenizer}",
            "model_name": "{model}"
          }
        },
        "pack": {
          "format": "strata",
          "required_files": [
            "dense.bin",
            "index.txt",
            "native_experts.txt",
            "tokenizer/tokenizer.json"
          ],
          "argv": [
            "/opt/strata/.venv/bin/python",
            "-m",
            "serve.server",
            "--engine",
            "strata",
            "--config",
            "{config_path}",
            "--host",
            "127.0.0.1",
            "--port",
            "8081"
          ],
          "cwd": "/opt/strata",
          "base_url": "http://127.0.0.1:8081",
          "context": 32768,
          "context_limits": {
            "min": 4096,
            "max": 131072,
            "presets": [
              4096,
              8192,
              16384,
              32768,
              65536,
              131072
            ],
            "adjustable": true
          },
          "artifacts": {
            "native": {
              "kind": "file",
              "format": "gguf"
            },
            "tokenizer": {
              "kind": "directory",
              "required_files": [
                "tokenizer.json"
              ]
            }
          },
          "config_template": {
            "exe": "/opt/strata/build/strata",
            "cwd": "/opt/strata",
            "args": [
              "--max-context",
              "{context}",
              "--pack",
              "{path}",
              "--native",
              "{artifact.native}"
            ],
            "tokenizer": "{artifact.tokenizer}",
            "model_name": "{model}"
          }
        }
      }
    },
    "kyojin": {
      "label": "Kyojin",
      "models": {
        "qwen3.8-flash-next-kyojin": {
          "argv": [
            "/opt/kyojin/.venv/bin/python",
            "-u",
            "/opt/kyojin/tools/qwen/serve.py",
            "--model",
            "/opt/models/qwen3.8-flash-next-exl3",

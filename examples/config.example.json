            "qwen3.8-flash-next-kyojin",
            "--host",
            "127.0.0.1",
            "--port",
            "8082",
            "--ctx",
            "{context}",
            "--cache-bits",
            "8",
            "--draft-policy",
            "mtp",
            "--ndt",
            "4",
            "--sessions",
            "1",
            "--no-vision",
            "--slot-save-path",
            "/var/lib/inference-gateway-manager/kyojin-slots"

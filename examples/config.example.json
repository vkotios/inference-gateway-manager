{
  "host": "127.0.0.1",
  "port": 9000,
  "recovery": {
    "restart_gateway": false,
    "reboot_host": false
  },
  "allowed_hosts": [
    "127.0.0.1",
    "localhost"
  ],
  "allowed_networks": [
    "127.0.0.0/8"
  ],
  "native_matchers": [
    {
      "exe": "llama-server"
    },
    {
      "argv_contains": "serve.server"
    },
    {
      "argv_contains": "tools/qwen/serve.py"
    },
    {
      "argv_contains": "tools/glm/serve.py"
    },
    {
      "argv_contains": "tools/mimo/serve.py"
    },
    {
      "exe": "ds4-server"
    },
    {
      "exe": "gufo"
    },
    {
      "exe": ".gufo-wrapped"
    },
    {
      "exe": "gufo-server"
    },
    {
      "exe": "luce_server"
    },
    {
      "exe": "ds4a-server"
    },
    {
      "exe": "ds4fa-server"
    },
    {
      "exe": "talus-server"
    },
    {
      "exe": "halogen"
    },
    {
      "exe": "flash_serve"
    },
    {
      "exe": "strix_server"
    },
    {
      "exe": "talus-cli"
    },
    {
      "argv_contains": "/halogen/tools/serve_api.py"
    }
  ],
  "engines": {
    "llama": {
      "models": {
        "example-llama": {
          "argv": [
            "/opt/llama/llama-server",

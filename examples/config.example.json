        },
        "hybrid-gguf": {
          "argv": [
            "/opt/llama/llama-server",
            "-m",
            "{path}",
            "--host",
            "127.0.0.1",
            "--port",
            "8080",
            "--slots",
            "--ctx-size",
            "{context}",
            "--alias",
            "{model}"

          "base_url": "http://127.0.0.1:8080",
          "context": 32768,
          "format": "gguf",
          "context_limits": {
            "min": 4096,
            "max": 131072,
            "presets": [
              4096,
              8192,
              16384,
              32768,
              65536,
              131072
            ],
            "adjustable": true
          },
          "reasoning_modes": [
            "auto",
            "on",
            "off"
          ],
          "reasoning_change": "request",
          "reasoning_defaults": {
            "on": {
              "/v1/chat/completions": {
                "chat_template_kwargs": {
                  "enable_thinking": true
                }
              },
              "/v1/responses": {
                "reasoning": {
                  "effort": "medium"
                }
              }
            },
            "off": {
              "/v1/chat/completions": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              },
              "/v1/responses": {
                "reasoning": {
                  "effort": "none"
                }
              }
            }
          },
          "label": "Hybrid reasoning GGUF (administrator reviewed Qwen3.8 template)",
          "supported_architectures": [
            "qwen35"
          ]
        }
      }
    },
